# Model provider: anthropic or openai_compatible
HISTORYBOT_LLM_PROVIDER=anthropic
HISTORYBOT_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=

# For an OpenAI-compatible gateway, use these instead of the Anthropic fields.
HISTORYBOT_BASE_URL=https://your-gateway.example
HISTORYBOT_API_KEY=

HISTORYBOT_HTTP_TIMEOUT=300
HISTORYBOT_HTTP_RETRIES=3
HISTORYBOT_MAX_TOKENS=4096
