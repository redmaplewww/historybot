      "recomputed_passages": 202,
      "count_match": true,
      "differing": 5,
      "sample": [
        {
          "ordinal": 2,
          "old": "年十五，封武德侯，爲齊公，三年爲平原王。",
          "new": "年十五，封武德侯，黃初二年爲齊公，三年爲平原王。"
        },
        {
          "ordinal": 14,
          "old": "春正月，郊祀武皇帝以配天，宗祀文皇帝於明堂以配上帝。",
          "new": "太和元年春正月，郊祀武皇帝以配天，宗祀文皇帝於明堂以配上帝。"
        },
        {
          "ordinal": 86,
          "old": "春正月甲申，青龍見郟之摩陂井中。",
          "new": "青龍元年春正月甲申，青龍見郟之摩陂井中。"
        },
        {
          "ordinal": 146,
          "old": "春正月壬辰，山茌縣言黃龍見。",
          "new": "景初元年春正月壬辰，山茌縣言黃龍見。"
        }
      ]
    },
