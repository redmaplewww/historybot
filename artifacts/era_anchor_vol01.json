      "ordinal": 18,
      "era": "是歲中平",
      "year": "六",
      "text": "冬十二月，始起兵於己吾，是歲中平六年也。"
    },
    {
      "ordinal": 19,
      "era": "初平",
      "year": "元",
      "text": "初平元年春正月，後將軍袁術、冀州牧韓馥、豫州刺史孔伷、兖州刺史劉岱、河內太守王匡、勃海太守袁紹、陳留太守張邈、東郡太守橋"
    },
    {
      "ordinal": 62,
      "era": "興平",
      "year": "元",
      "text": "興平元年春，太祖自徐州還，初，太祖父嵩去官後還譙，董卓之亂，避難琅邪，爲陶謙所害，故太祖志在復讎東伐。"
    },
    {
      "ordinal": 89,
      "era": "建安",
      "year": "元",
      "text": "建安元年春正月，太祖軍臨武平，袁術所置陳相袁嗣降。"
    },
    {
      "ordinal": 215,
      "era": "至是凡五",
      "year": "十",
      "text": "至是凡五十年，而公破紹，天下莫敵矣。"
    },
    {
      "ordinal": 234,
      "era": "十有",
      "year": "五",
      "text": "秋七月，令曰：「喪亂已來，十有五年，後生者不見仁義禮讓之風，吾甚傷之。"
    },
    {
      "ordinal": 301,
      "era": "十",
      "year": "二",
      "text": "十二年春二月，公自淳于還鄴。"
    },
    {
      "ordinal": 302,
      "era": "於今十",
      "year": "九",
      "text": "丁酋，令曰：「吾起義兵誅暴亂，於今十九年，所征必克，豈吾功哉？"
    },
    {
      "ordinal": 322,
      "era": "十",
      "year": "三",
      "text": "十三年春正月，公還鄴，作玄武池以肄舟師。"
    },
    {
      "ordinal": 333,
      "era": "十",
      "year": "四",
      "text": "十四年春三月，軍至譙，作輕舟，治水軍。"
    },
    {
      "ordinal": 338,
      "era": "十",
      "year": "五",
      "text": "十五年春，下令曰：「自古受命及中興之君，曷甞不得賢人君子與之共治天下者乎！"
    },
    {
      "ordinal": 346,
      "era": "十",
      "year": "六",
      "text": "十六年春正月，天子命公世子丕爲五官中郎將，置官屬，爲丞相副。"
    },
    {
      "ordinal": 369,
      "era": "不一",
      "year": "二",
      "text": "公荅曰：「關中長遠，若賊各依險阻，征之，不一二年不可定也。"
    },
    {
      "ordinal": 377,
      "era": "十",
      "year": "八",
      "text": "十八年春正月，進軍濡須口，攻破權江西營，獲權都督公孫陽，乃引軍還。"
    },
    {
      "ordinal": 423,
      "era": "十",
      "year": "九",
      "text": "十九年春正月，始耕籍田。"
    },
    {
      "ordinal": 442,
      "era": "二",
      "year": "十",
      "text": "二十年春正月，天子立公中女爲皇后。"
    },
    {
      "ordinal": 460,
      "era": "二十",
      "year": "一",
      "text": "二十一年春二月，公還鄴。"
    },
    {
      "ordinal": 467,
      "era": "二十",
      "year": "二",
      "text": "二十二年春正月，王軍居巢，二月，進軍屯江西郝谿。"
    },
    {
      "ordinal": 474,
      "era": "二十",
      "year": "三",
      "text": "二十三年春正月，漢太醫令吉本與少府耿紀、司直韋晃等反，攻許，燒丞相長史王必營，必與潁川典農中郎將嚴匡討斬之。"
    },
    {
      "ordinal": 485,
      "era": "二十",
      "year": "四",
      "text": "二十四年春正月，仁屠宛，斬音。"
    },
    {
      "ordinal": 493,
      "era": "二十",
      "year": "五",
      "text": "二十五年春正月，至洛陽。"
    }
